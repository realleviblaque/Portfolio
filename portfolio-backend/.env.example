# Runtime mode: development locally; set to production on the hosted backend.
NODE_ENV=development

# Express listen port.
PORT=5000

# MongoDB connection URI used by the backend and MongoDB-backed session store.
MONGODB_URI=mongodb://127.0.0.1:27017/levi-blaque-portfolio

# Private session signing secret (at least 32 characters). Generate a unique
# value for each environment and set it in the host's secret manager. Never commit it.
SESSION_SECRET=

# Session idle lifetime in milliseconds. Cookie and MongoDB store TTL use this value.
SESSION_IDLE_TIMEOUT=1800000

# Maximum session lifetime in milliseconds, regardless of activity. Enforced by
# the authentication session validation middleware.
SESSION_ABSOLUTE_TIMEOUT=43200000

# Express trusted proxy hop count. Use 0 for local direct HTTP. Configure the exact
# trusted hop count for the deployed reverse-proxy path; avoid blindly trusting all proxies.
TRUST_PROXY=0

# Browser frontend origin allowed for state-changing authentication requests.
# Production must use the exact deployed Vercel origin; do not add a path.
FRONTEND_ORIGIN=http://localhost:5173
